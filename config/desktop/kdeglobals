# SANORA OS - system-wide KDE defaults.
# KDE reads defaults from $XDG_CONFIG_DIRS (normally /etc/xdg), so a clean
# user account with no ~/.config gets these values on first login.
# See config/desktop/README.md and branding/plasma/README.md.

[KDE]
# The original SANORA Global Theme KPackage shipped by sanora-base.
LookAndFeelPackage=org.sanora.light.desktop
widgetStyle=Breeze

[General]
ColorScheme=SANORALight

[Icons]
Theme=sanora

[WM]
activeBackground=18,40,60
activeForeground=242,246,250
inactiveBackground=24,48,69
inactiveForeground=170,190,205
