# SANORA OS build constants. Sourced by build.sh and by build/scripts/*.
# This is the single source of truth for version and base distribution metadata.
# Keep this file POSIX-shell compatible and free of command substitutions.

SANORA_VERSION=0.1.0-dev
SANORA_CODENAME=genesis
SANORA_NAME="SANORA OS"
SANORA_ID=sanora
SANORA_HOMEPAGE=https://github.com/bmeesss/SANORA-OS

DEBIAN_SUITE=trixie
DEBIAN_VERSION=13
SANORA_ARCH=amd64

# International default. Additional locales are added by later work, not here.
SANORA_DEFAULT_LOCALE=en_US.UTF-8
SANORA_DEFAULT_KEYBOARD=us

# ISO9660 volume IDs are limited to 32 characters.
SANORA_ISO_VOLUME=SANORA-DEV
SANORA_IMAGE_NAME=sanora-dev

# Debian mirrors used by lb config. Override in the environment if needed.
SANORA_DEBIAN_MIRROR=https://deb.debian.org/debian/
SANORA_SECURITY_MIRROR=https://security.debian.org/debian-security/
